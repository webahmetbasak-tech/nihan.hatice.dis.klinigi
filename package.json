{
  "name": "dental-experience",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:kutahyaakademi": "ng serve -c kutahyaakademi",
    "start:kadriye-ozkul": "ng serve -c kadriye-ozkul",
    "start:dtnazliyoluc": "ng serve -c dtnazliyoluc",
    "start:nihan_hatice_disklinigi": "ng serve -c nihan_hatice_disklinigi",
    "build": "node scripts/build.mjs",
    "build:kutahyaakademi": "node scripts/build.mjs kutahyaakademi",
    "build:kadriye-ozkul": "node scripts/build.mjs kadriye-ozkul",
    "build:dtnazliyoluc": "node scripts/build.mjs dtnazliyoluc",
    "build:nihan_hatice_disklinigi": "node scripts/build.mjs nihan_hatice_disklinigi",
    "build:all": "node scripts/build.mjs kutahyaakademi && node scripts/build.mjs kadriye-ozkul && node scripts/build.mjs dtnazliyoluc && node scripts/build.mjs nihan_hatice_disklinigi",
    "preview": "npx --yes serve dist/app/browser -l 4300",
    "images:optimize": "node scripts/optimize-images.mjs",
    "watch": "ng build --watch --configuration development"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
